# ==============================================================================
# MuleShield AI — Environment Configuration Template
# SIH26184 | Ministry of Home Affairs (MHA) / I4C
# ==============================================================================

# ------------------------------------------------------------------------------
# Authentication & Cryptography
# ------------------------------------------------------------------------------
# OWASP PBKDF2-HMAC-SHA256 iterations for password storage.
# Production floor is 600,000 (~300ms/login). Set to 50,000 for sub-50ms demo/dev.
PBKDF2_ITERATIONS=600000

# Account Lockout Gate (1 = enabled, 0 = disabled)
# Configurable security control: production enables 3-attempt account lockout.
# Set LOCKOUT_ENABLED=0 in demo/evaluation environments to allow unrestricted retries
# while continuing to track failed attempt telemetry (failed_logins_total).
LOCKOUT_ENABLED=1

# Maximum consecutive failed login attempts before account lockout occurs.
MAX_FAILED_LOGINS=3

# Duration (in minutes) an account remains locked after tripping MAX_FAILED_LOGINS.
LOCKOUT_MINUTES=15

# ------------------------------------------------------------------------------
# Officer Credentials & Database
# ------------------------------------------------------------------------------
# Pre-seeded Duty Officer administrator username and initial password.
MULESHIELD_ADMIN_USER=officer
MULESHIELD_ADMIN_PASSWORD=change-me

# Local SQLite path for credentials, audit events, and sessions.
MULESHIELD_DB_PATH=data/muleshield.db

# ------------------------------------------------------------------------------
# Proactive Scheduler & Analytical Services
# ------------------------------------------------------------------------------
# Background alert rule pass scheduler (on / off). Set to "off" during unit testing.
MULESHIELD_SCHEDULER=on

# Interval in seconds between proactive batch rule passes over the hotspot surface.
MULESHIELD_TICK_SECONDS=60
