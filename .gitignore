# ── Generated dataset ────────────────────────────────────────────────────────
# transactions.csv is ~114 MB and graph_edges.csv ~40 MB at the current corpus
# size, past GitHub's 100 MB limit. Both are fully reproducible and deterministic
# (seed 42), so the generator is the source of truth rather than the artefact:
#
#     python scripts/generate_data.py
#
# The small CSVs stay tracked so the repo is inspectable without a full run.
data/transactions.csv
data/graph_edges.csv

# Screen recordings and scratch analysis output. The underscore-prefixed files
# are per-run diagnostics written by the evaluation scripts; the reproducible
# results they summarise live in data/metrics.json.
*.mp4
*.mov
data/_*.csv
data/_*.npy

# Isolated build used by scripts/smoke_ui.py. It points at a throwaway backend
# port, so it must never be served to anyone.
frontend/dist-smoke/

# Pitch material stays local. It is strategy, not source -- what we lead with,
# what we volunteer about our own weaknesses, and how we answer the questions we
# expect. Not something to publish while the competition is running.
docs/PITCH.md
docs/PROJECT_INVENTORY.md
docs/CONTEXT_HANDOFF.md
docs/MODEL_DEFENSE.md
docs/DISCUSSION_NOTES.md

# Superseded planning docs and UI-generator prompts. Kept locally, off GitHub.
docs/archive/

# Officer credentials. Never commit this -- it holds password hashes and live
# session tokens, and a committed copy would put a working login for every
# deployment into a public repository.
data/muleshield.db
data/muleshield.db-wal
data/muleshield.db-shm
